<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--
		Material 3 semantic palette.
		Seed color: #F3AC70 (the app icon background orange), style: TonalSpot.
		Generated with MaterialColorUtilities (LightSchemeMapper / DarkSchemeMapper).
		The surface roles stay close to neutral - only lightly tinted - which is what keeps the
		depth relationships of the original design intact; the accent roles carry the orange.
	-->

	<!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml
	     and Platforms\Android\Resources\values-night\colors.xml (the status bar, the app bar
	     background and the Material widget colors). -->

	<Color x:Key="Primary">#88511D</Color>
	<Color x:Key="OnPrimary">#FFFFFF</Color>
	<Color x:Key="PrimaryContainer">#FFDCC2</Color>
	<Color x:Key="OnPrimaryContainer">#2E1500</Color>

	<Color x:Key="PrimaryDark">#FFB77B</Color>
	<Color x:Key="OnPrimaryDark">#4D2700</Color>
	<Color x:Key="PrimaryContainerDark">#6C3A06</Color>
	<Color x:Key="OnPrimaryContainerDark">#FFDCC2</Color>

	<Color x:Key="Secondary">#745944</Color>
	<Color x:Key="OnSecondary">#FFFFFF</Color>
	<Color x:Key="SecondaryContainer">#FFDCC2</Color>
	<Color x:Key="OnSecondaryContainer">#2A1707</Color>

	<Color x:Key="SecondaryDark">#E3C0A6</Color>
	<Color x:Key="OnSecondaryDark">#412C19</Color>
	<Color x:Key="SecondaryContainerDark">#5A422E</Color>
	<Color x:Key="OnSecondaryContainerDark">#FFDCC2</Color>

	<Color x:Key="Tertiary">#5C6237</Color>
	<Color x:Key="OnTertiary">#FFFFFF</Color>
	<Color x:Key="TertiaryContainer">#E0E7B1</Color>
	<Color x:Key="OnTertiaryContainer">#191E00</Color>

	<Color x:Key="TertiaryDark">#C4CB97</Color>
	<Color x:Key="OnTertiaryDark">#2E330D</Color>
	<Color x:Key="TertiaryContainerDark">#444A22</Color>
	<Color x:Key="OnTertiaryContainerDark">#E0E7B1</Color>

	<Color x:Key="SurfaceLight">#FFF8F5</Color>
	<Color x:Key="SurfaceContainerLight">#F7ECE5</Color>
	<Color x:Key="SurfaceVariantLight">#EEE0D7</Color>
	<Color x:Key="OnSurfaceLight">#201B17</Color>
	<Color x:Key="OnSurfaceVariantLight">#4C4541</Color>
	<Color x:Key="OutlineLight">#7E7570</Color>
	<Color x:Key="OutlineVariantLight">#CFC4BE</Color>

	<Color x:Key="SurfaceDark">#17120F</Color>
	<Color x:Key="SurfaceContainerDark">#241F1B</Color>
	<Color x:Key="SurfaceVariantDark">#51443B</Color>
	<Color x:Key="OnSurfaceDark">#ECE0DA</Color>
	<Color x:Key="OnSurfaceVariantDark">#CFC4BE</Color>
	<Color x:Key="OutlineDark">#988F89</Color>
	<Color x:Key="OutlineVariantDark">#4C4541</Color>

	<!-- Backwards-compatible aliases: the "dark text" roles are the on-color roles. -->
	<Color x:Key="PrimaryDarkText">#4D2700</Color>
	<Color x:Key="SecondaryDarkText">#412C19</Color>

	<Color x:Key="White">White</Color>
	<Color x:Key="Black">Black</Color>
	<Color x:Key="Magenta">#F3AC70</Color>
	<Color x:Key="MidnightBlue">#201B17</Color>
	<Color x:Key="OffBlack">#17120F</Color>

	<Color x:Key="Gray100">#F6ECE7</Color>
	<Color x:Key="Gray200">#EEE0D7</Color>
	<Color x:Key="Gray300">#CDC3BD</Color>
	<Color x:Key="Gray400">#988F89</Color>
	<Color x:Key="Gray500">#7E7570</Color>
	<Color x:Key="Gray600">#4C4541</Color>
	<Color x:Key="Gray900">#201B17</Color>
	<Color x:Key="Gray950">#17120F</Color>

	<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
	<SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
	<SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
	<SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>
	<SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}"/>
	<SolidColorBrush x:Key="SurfaceContainerLightBrush" Color="{StaticResource SurfaceContainerLight}"/>
	<SolidColorBrush x:Key="SurfaceContainerDarkBrush" Color="{StaticResource SurfaceContainerDark}"/>
	<SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
	<SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

	<SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
	<SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
	<SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
	<SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
	<SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
	<SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
	<SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
	<SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
