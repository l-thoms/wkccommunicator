<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch window background for the dark theme.

    The light version (generated by the MAUI splash screen build step) paints the app icon orange
    and centres the splash art on it. In the dark theme the system turns the launch background dark
    by itself, so this layer list keeps the background transparent and only draws the splash art -
    which in this configuration (drawable-night/splash.png) is the app logo with a transparent
    background, i.e. exactly the artwork of the original splash SVG without the orange plate.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/transparent" />
    <item
        android:drawable="@drawable/maui_splash_image"
        android:gravity="center" />
</layer-list>
